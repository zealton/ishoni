# /etc/sudoers.d/ishoni-gateway-deploy (mode 0440, check with `visudo -cf`). Replace RUNNER_USER with the account the
# ishoni-gateway GitHub Actions runner service runs as. It may run the deploy script, with one argument, and nothing else.
RUNNER_USER ALL=(root) NOPASSWD: /usr/local/sbin/ishoni-gateway-deploy v*
